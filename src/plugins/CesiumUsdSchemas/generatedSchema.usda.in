class "CesiumGlobeAnchorSchemaAPI" (
    customData = {
        string userDocBrief = "Adds Globe Anchoring information to a Prim for use with Cesium for Omniverse."
    }
)
{
    bool cesium:anchor:adjustOrientationForGlobeWhenMoving = 1 (
        customData = {
            string userDocBrief = "Gets or sets whether to adjust the Prim's orientation based on globe curvature as the game object moves."
        }
        displayName = "Adjust Orientation for Globe when Moving"
    )
    bool cesium:anchor:detectTransformChanges = 1 (
        customData = {
            string userDocBrief = "Gets or sets whether to automatically detect changes in the Prim's transform and update the precise globe coordinates accordingly."
        }
        displayName = "Detect Transform Changes"
    )
    rel cesium:anchor:georeferenceBinding (
        customData = {
            string userDocBrief = "The Georeference Origin prim used for the globe anchor calculations."
        }
        displayName = "Georeference Origin Binding"
    )
    double cesium:anchor:height = 0 (
        customData = {
            string userDocBrief = "The height in meters above the ellipsoid."
        }
        displayName = "Height"
    )
    double cesium:anchor:latitude = 0 (
        customData = {
            string userDocBrief = "The latitude in degrees, in the range [-90, 90]."
        }
        displayName = "Latitude"
    )
    double cesium:anchor:longitude = 0 (
        customData = {
            string userDocBrief = "The longitude in degrees, in the range [-180, 180]."
        }
        displayName = "Longitude"
    )
    double3 cesium:anchor:position = (0, 0, 0) (
        customData = {
            string userDocBrief = "The actual position of the globally anchored prim in the ECEF coordinate system."
        }
        displayName = "Position (ECEF)"
    )
}

